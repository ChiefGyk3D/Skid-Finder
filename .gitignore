# Logs and captures
logs/*.txt
logs/*.log
logs/*.pcapng
logs/*.btsnoop
logs/*.csv
logs/*.json
logs/*.tmp
logs/*.gz
!logs/.gitkeep

# Python cache
__pycache__/
*.pyc

# Local/editor temp files
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.idea/

# Local operator config (copy from the .example files, keep local)
config/interfaces.conf
config/signatures.conf
config/wifi-signatures.conf
config/aio-features.conf
# A watchlist holds addresses and names of other people's devices. Never commit it.
config/watchlist.conf
config/*.bak-*

# Operator-provided real captures for the detector corpus (privacy + size).
tests/corpus/real/*
!tests/corpus/real/README.md
!tests/corpus/real/.gitkeep
