# Labeled detector corpus. One JSON object per line; '#' lines and blank lines
# are ignored. tests/test-detector-metrics.py reads this file, materialises
# each sample, runs scripts/ble-signature-scan.py across every profile, and
# computes precision/recall so detector changes are measured, not guessed.
#
# Fields:
#   kind      "synthetic" (generated by tests/make-fixture.py) or "real"
#   label     "ambient" (must NOT match any signature) or "spam" (must match)
#   mode      synthetic only: make-fixture.py mode
#   duration  synthetic only: seconds of traffic to generate
#   rate      synthetic only: advertisements per second
#   seed      synthetic only: RNG seed, for reproducibility
#   families  spam only, optional: signature families the sample should exhibit
#   path      real only: file under tests/corpus/real/ (git-ignored; see README)
#   note      free text
#
# --- ambient: ordinary venue traffic, including spam-level event volume ------
# These are the false-positive guard. Detection must key on address-reuse
# SHAPE, not volume, so ambient at rate 45 (as busy as the spam samples) must
# still produce zero matches.
{"kind":"synthetic","label":"ambient","mode":"ambient","duration":30,"rate":30,"seed":1}
{"kind":"synthetic","label":"ambient","mode":"ambient","duration":30,"rate":30,"seed":2}
{"kind":"synthetic","label":"ambient","mode":"ambient","duration":30,"rate":45,"seed":3}
{"kind":"synthetic","label":"ambient","mode":"ambient","duration":30,"rate":45,"seed":4}
{"kind":"synthetic","label":"ambient","mode":"ambient","duration":60,"rate":45,"seed":5}
# --- spam: MAC-rotating Apple-popup flood ------------------------------------
{"kind":"synthetic","label":"spam","mode":"spam","duration":30,"rate":30,"seed":1,"families":["flipper","random_churn","generic"]}
{"kind":"synthetic","label":"spam","mode":"spam","duration":30,"rate":45,"seed":2,"families":["flipper","random_churn","generic"]}
{"kind":"synthetic","label":"spam","mode":"spam","duration":30,"rate":45,"seed":3,"families":["flipper","random_churn","generic"]}
{"kind":"synthetic","label":"spam","mode":"spam","duration":60,"rate":60,"seed":4,"families":["flipper","random_churn","generic"]}
# --- spam: Fast Pair lure flood ----------------------------------------------
{"kind":"synthetic","label":"spam","mode":"fastpair","duration":30,"rate":15,"seed":1,"families":["fastpair"]}
{"kind":"synthetic","label":"spam","mode":"fastpair","duration":30,"rate":25,"seed":2,"families":["fastpair"]}
{"kind":"synthetic","label":"spam","mode":"fastpair","duration":60,"rate":25,"seed":3,"families":["fastpair"]}
# --- real captures: operator-provided field baselines ------------------------
# Uncomment and point at files you drop under tests/corpus/real/ after taking
# your own quiet-ambient baseline. Absent files are skipped, not failed, so CI
# stays green without them. See tests/corpus/real/README.md.
# {"kind":"real","label":"ambient","path":"real/quiet-office-20260820.log","note":"home baseline, no BLE spam present"}
# {"kind":"real","label":"spam","path":"real/confirmed-flipper-20260808.log","note":"BSidesLV, Flipper observed in hand"}
{"kind":"real","label":"ambient","path":"real/quiet-desktop-20260819.log","note":"desktop-nos internal Realtek, home RF"}
