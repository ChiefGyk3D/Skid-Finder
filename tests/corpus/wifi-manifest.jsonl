# Labeled Wi-Fi detector corpus. Same shape as manifest.jsonl; read by
# tests/test-detector-metrics.py --modality wifi. Synthetic samples come from
# tests/make-wifi-fixture.py; real captures (tshark field .tsv, git-ignored
# under real/) are folded in when present.
#
# None of the Wi-Fi thresholds have been measured against a real venue yet.
# The first real ambient sample recorded here is the baseline the roadmap
# calls for.
# --- ambient: a venue's own APs, clients probing, an occasional real deauth --
{"kind":"synthetic","label":"ambient","mode":"ambient","duration":30,"seed":1}
{"kind":"synthetic","label":"ambient","mode":"ambient","duration":30,"seed":2}
{"kind":"synthetic","label":"ambient","mode":"ambient","duration":60,"seed":3}
{"kind":"synthetic","label":"ambient","mode":"ambient","duration":120,"seed":4}
