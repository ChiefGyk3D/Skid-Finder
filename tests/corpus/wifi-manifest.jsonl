{"kind":"synthetic","label":"spam","mode":"deauth","duration":30,"seed":1,"families":["deauth"]}
{"kind":"synthetic","label":"spam","mode":"deauth","duration":30,"rate":12,"seed":2,"families":["deauth"]}
{"kind":"synthetic","label":"spam","mode":"beacon","duration":30,"seed":1,"families":["beacon"]}
{"kind":"synthetic","label":"spam","mode":"beacon","duration":30,"rate":10,"seed":2,"families":["beacon"]}
{"kind":"synthetic","label":"spam","mode":"evil_twin","duration":30,"seed":1,"families":["evil_twin"]}
{"kind":"synthetic","label":"spam","mode":"karma","duration":30,"seed":1,"families":["karma"]}
